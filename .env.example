# Gere uma chave com o Python da .venv e django.core.management.utils.get_random_secret_key.
SECRET_KEY=change-me-please-use-django-utils-get_random_secret_key

# Mantenha True para o uso local.
DEBUG=True

# Hosts permitidos. Acrescente o hostname retornado pelo Cloudflare Tunnel.
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Para usar o sistema pelo túnel: CSRF_TRUSTED_ORIGINS=https://seu-hostname.trycloudflare.com
# Em HTTPS (incluindo túnel), defina ambas como True. False permite HTTP local.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Origens CORS permitidas (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
