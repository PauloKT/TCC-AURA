# AURA — variáveis de ambiente (exemplo)
# Copie para .env e ajuste os valores para o seu ambiente.

# Chave secreta do Django. Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-please-use-django-utils-get_random_secret_key

# True em desenvolvimento, False em produção.
DEBUG=True

# Hosts permitidos (separados por vírgula). Em produção, inclua o domínio real.
ALLOWED_HOSTS=127.0.0.1,localhost

# Origens CORS permitidas (separadas por vírgula). Útil em produção com domínio próprio.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000


# Banco de dados. Padrão: sqlite. Para Postgres:
# DB_ENGINE=postgres
# DB_NAME=aura
# DB_USER=aura
# DB_PASSWORD=aura
# DB_HOST=db
# DB_PORT=5432
DB_ENGINE=sqlite
